---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';

// Nota: Asegúrate que tus archivos CSS y config.js tengan colores slate/blue
---

<Layout title="Estudio Galimberti | Asesoría Legal Personalizada">

    <Navbar />

    <main class="pt-5">

        <section id="inicio" class="relative pt-25 pb-16 lg:pt-48 lg:pb-32 bg-gradient-to-b from-white to-slate-50 overflow-hidden">
            
            <div class="absolute top-0 right-0 -translate-y-1/4 translate-x-1/4 w-[500px] h-[500px] bg-blue-100/50 rounded-full blur-3xl -z-10"></div>

            <div class="max-w-7xl mx-auto px-6 lg:px-8">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                    
                    <div class="relative z-10">
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-100 text-blue-700 text-xs font-bold tracking-wide uppercase mb-6">
                            <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
                            Asesoría Penal y Corporativa
                        </div>
                        
                        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-slate-900 font-sans leading-[1.1] mb-6">
                            Protegemos su patrimonio con <br>
                            <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 to-blue-500">Estrategia Inteligente.</span>
                        </h1>
                        
                        <p class="text-lg text-slate-600 mb-8 max-w-lg leading-relaxed">
                            Especialistas en la resolución de conflictos complejos: <strong>Penal Económico, Aduanero y Societario</strong>. Un enfoque preventivo para blindar el futuro de su empresa.
                        </p>

                        <div class="flex flex-col sm:flex-row gap-4">
                            <a href="#contacto" class="inline-flex items-center justify-center px-8 py-4 text-base font-bold text-white transition-all bg-slate-900 rounded-xl hover:bg-slate-800 shadow-xl hover:shadow-2xl hover:-translate-y-1">
                                Agendar Consulta Privada
                            </a>
                            <a href="#servicios" class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-slate-700 transition-all bg-white border border-slate-200 rounded-xl hover:bg-slate-50 hover:text-blue-700">
                                Explorar Áreas
                            </a>
                        </div>

                        <div class="mt-10 flex items-center gap-6 text-sm font-medium text-slate-500">
                            <div class="flex items-center gap-2">
                                <svg class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                <span>Atención Inmediata</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <svg class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                                <span>Confidencialidad 100%</span>
                            </div>
                        </div>
                    </div>

                    <div class="relative lg:h-auto flex justify-center lg:justify-end">
                        <div class="relative w-full max-w-md">
                            <div class="absolute inset-0 bg-blue-600 rounded-2xl transform rotate-3 translate-x-2 translate-y-2 opacity-20"></div>
                            <img 
                                src="https://images.unsplash.com/photo-1556761175-5973dc0f32e7?q=80&w=1600&auto=format&fit=crop" 
                                alt="Oficina Estudio Galimberti" 
                                class="relative rounded-2xl shadow-2xl border border-white w-full h-[450px] object-cover bg-slate-200"
                            />

                            <div class="absolute -bottom-6 -left-6 bg-white p-5 rounded-xl shadow-xl border border-slate-100 flex items-center gap-4 max-w-[240px] animate-in fade-in slide-in-from-bottom-4 duration-1000">
                                <div class="w-12 h-12 bg-blue-50 rounded-full flex items-center justify-center text-blue-700 text-xl font-bold">
                                    15+
                                </div>
                                <div>
                                    <p class="text-xs text-slate-500 uppercase tracking-wider font-semibold">Experiencia</p>
                                    <p class="text-sm font-bold text-slate-900 leading-tight">Años de trayectoria en litigios complejos.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>


        <section id="servicios" class="py-24 bg-slate-50">
            <div class="max-w-7xl mx-auto px-6 lg:px-8">
                
                <div class="text-center max-w-4xl mx-auto mb-16">
                    <h2 class="text-3xl font-bold text-slate-900 font-sans mb-4">Áreas de Práctica y Alto Riesgo</h2>
                    <p class="text-lg text-gray-600">
                        Ofrecemos asesoramiento en las ramas más técnicas y cruciales del derecho, con enfoque en la resolución y la prevención.
                    </p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                    
                    <div class="group p-8 rounded-xl bg-white border border-slate-100 shadow-md hover:shadow-xl hover:border-blue-400 transition-all duration-300 hover:-translate-y-1">
                        <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center text-red-600 text-2xl mb-4 group-hover:bg-blue-600 group-hover:text-white transition-colors">
                            💰
                        </div>
                        <h3 class="text-xl font-bold text-slate-900 mb-2 font-sans">Penal Económico</h3>
                        <p class="text-sm text-gray-600">Defensa en delitos financieros, fraudes, evasión y cuestiones tributarias complejas. (Alto Riesgo)</p>
                    </div>

                    <div class="group p-8 rounded-xl bg-white border border-slate-100 shadow-md hover:shadow-xl hover:border-blue-400 transition-all duration-300 hover:-translate-y-1">
                        <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center text-blue-700 text-2xl mb-4 group-hover:bg-blue-600 group-hover:text-white transition-colors">
                            🚢
                        </div>
                        <h3 class="text-xl font-bold text-slate-900 mb-2 font-sans">Derecho Aduanero</h3>
                        <p class="text-sm text-gray-600">Asesoramiento en importaciones, exportaciones y defensa en sumarios e infracciones aduaneras.</p>
                    </div>

                    <div class="group p-8 rounded-xl bg-white border border-slate-100 shadow-md hover:shadow-xl hover:border-blue-400 transition-all duration-300 hover:-translate-y-1">
                        <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center text-blue-700 text-2xl mb-4 group-hover:bg-blue-600 group-hover:text-white transition-colors">
                            🤝
                        </div>
                        <h3 class="text-xl font-bold text-slate-900 mb-2 font-sans">Derecho Societario</h3>
                        <p class="text-sm text-gray-600">Constitución, estatutos, conflictos societarios y fusiones/adquisiciones. Estrategia corporativa.</p>
                    </div>

                    <div class="group p-8 rounded-xl bg-white border border-slate-100 shadow-md hover:shadow-xl hover:border-blue-400 transition-all duration-300 hover:-translate-y-1">
                        <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center text-red-600 text-2xl mb-4 group-hover:bg-blue-600 group-hover:text-white transition-colors">
                            ⚖️
                        </div>
                        <h3 class="text-xl font-bold text-slate-900 mb-2 font-sans">Derecho Penal</h3>
                        <p class="text-sm text-gray-600">Defensa en procesos penales en todas las instancias y tipos de delitos.</p>
                    </div>

                    <div class="group p-8 rounded-xl bg-white border border-slate-100 shadow-md hover:shadow-xl hover:border-blue-400 transition-all duration-300 hover:-translate-y-1">
                        <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center text-blue-700 text-2xl mb-4 group-hover:bg-blue-600 group-hover:text-white transition-colors">
                            💼
                        </div>
                        <h3 class="text-xl font-bold text-slate-900 mb-2 font-sans">Derecho Laboral</h3>
                        <p class="text-sm text-gray-600">Asesoramiento a empleados y empleadores en conflictos, contratos y despidos.</p>
                    </div>

                    <div class="group p-8 rounded-xl bg-white border border-slate-100 shadow-md hover:shadow-xl hover:border-blue-400 transition-all duration-300 hover:-translate-y-1">
                        <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center text-blue-700 text-2xl mb-4 group-hover:bg-blue-600 group-hover:text-white transition-colors">
                            👨‍👩‍👧‍👦
                        </div>
                        <h3 class="text-xl font-bold text-slate-900 mb-2 font-sans">Sucesiones</h3>
                        <p class="text-sm text-gray-600">Gestión ágil de trámites sucesorios y protección del patrimonio familiar.</p>
                    </div>

                    <div class="lg:col-span-3 text-center py-6">
                        <p class="text-2xl font-bold text-slate-800 mb-2">Infracciones de Tránsito</p>
                        <p class="text-gray-600">Asesoramiento y defensa rápida en multas y licencias.</p>
                    </div>

                </div>

            </div>
        </section>

        <section id="contacto" class="py-20 bg-slate-900 text-white">
            <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
                <h2 class="text-3xl font-bold font-sans mb-3">Asesoría Personalizada, Soluciones Efectivas.</h2>
                <p class="text-lg text-gray-400 mb-8">
                    Contáctenos hoy para una evaluación experta de su caso en cualquiera de nuestras especialidades.
                </p>
                <a href="https://wa.me/5491100000000" class="inline-block px-10 py-4 bg-blue-500 text-white rounded-lg font-bold shadow-xl hover:bg-blue-600 transition-colors text-lg">
                    Iniciar Consulta Personalizada
                </a>
            </div>
        </section>

        <section id="filosofia" class="py-24 bg-slate-50">
            <div class="max-w-7xl mx-auto px-6 lg:px-8">
                
                <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-center">
                    
                    <div class="lg:col-span-2 relative">
                        <div class="p-8 bg-white border border-slate-200 rounded-xl shadow-xl">
                            <span class="block text-5xl text-blue-500 mb-4 font-serif">“</span>
                            <blockquote class="text-xl italic text-slate-700 leading-relaxed">
                                "En áreas de alto riesgo como el Derecho Penal o Aduanero, la solución no está en el Código, sino en un **análisis forense y una estrategia única**."
                            </blockquote>
                            <p class="mt-6 text-sm font-semibold text-slate-900">— Equipo Estudio Galimberti</p>
                        </div>
                        
                        <div class="absolute -bottom-4 -right-4 w-24 h-24 bg-blue-500/10 rounded-full flex items-center justify-center text-3xl opacity-80 shadow-lg">
                            🛡️
                        </div>
                    </div>

                    <div class="lg:col-span-3">
                        <span class="text-slate-600 font-semibold tracking-wider uppercase text-sm mb-2 block">Nuestro Enfoque Exclusivo</span>
                        
                        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 font-sans mb-8">
                            Análisis Profundo y Proximidad con el Cliente
                        </h2>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                            
                            <div class="flex gap-4">
                                <div class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center text-white text-xl shrink-0">1</div>
                                <div>
                                    <h3 class="font-bold text-slate-800">Visión 360°</h3>
                                    <p class="text-sm text-gray-600">
                                        Abordamos su caso desde todas las ramas (Penal, Aduanero, Societario) para asegurar una defensa sin puntos ciegos.
                                    </p>
                                </div>
                            </div>

                            <div class="flex gap-4">
                                <div class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center text-white text-xl shrink-0">2</div>
                                <div>
                                    <h3 class="font-bold text-slate-800">Atención Directa</h3>
                                    <p class="text-sm text-gray-600">
                                        La clave de la asesoría personalizada: usted habla con el especialista a cargo sin intermediarios.
                                    </p>
                                </div>
                            </div>
                            
                            <div class="flex gap-4">
                                <div class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center text-white text-xl shrink-0">3</div>
                                <div>
                                    <h3 class="font-bold text-slate-800">Estrategia Preventiva</h3>
                                    <p class="text-sm text-gray-600">
                                        No solo resolvemos litigios; le ofrecemos herramientas para evitar futuros conflictos legales.
                                    </p>
                                </div>
                            </div>
                            
                            <div class="flex gap-4">
                                <div class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center text-white text-xl shrink-0">4</div>
                                <div>
                                    <h3 class="font-bold text-slate-800">Liderazgo en Riesgo</h3>
                                    <p class="text-sm text-gray-600">
                                        Experiencia sólida en Derecho Penal Económico y Aduanero, garantizando manejo de alto riesgo.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                </div>
            </div>
</section>

    </main>

    <footer id="footer" class="bg-slate-950 text-gray-400 font-sans py-16 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-10">
            
            <div class="lg:col-span-1">
                <a href="/" class="text-2xl font-bold text-white font-sans block mb-4">
                    Estudio Galimberti
                </a>
                <p class="text-sm leading-relaxed mb-6">
                    Asesoría legal en las ramas más complejas del derecho. Nuestro enfoque es la solución personalizada y eficiente de su caso.
                </p>
                <div class="flex gap-4">
                    <a href="#" class="text-gray-500 hover:text-blue-400 transition-colors" aria-label="LinkedIn">
                        <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                    </a>
                </div>
            </div>

            <div>
                <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Especialidades</h3>
                <ul class="space-y-3 text-sm">
                    <li><a href="#servicios" class="hover:text-blue-400 transition-colors">Penal y Penal Económico</a></li>
                    <li><a href="#servicios" class="hover:text-blue-400 transition-colors">Derecho Aduanero</a></li>
                    <li><a href="#servicios" class="hover:text-blue-400 transition-colors">Laboral y Societario</a></li>
                    <li><a href="#servicios" class="hover:text-blue-400 transition-colors">Sucesiones y Familia</a></li>
                </ul>
            </div>

            <div>
                <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Acceso Rápido</h3>
                <ul class="space-y-3 text-sm">
                    <li><a href="#inicio" class="hover:text-blue-400 transition-colors">Inicio</a></li>
                    <li><a href="#servicios" class="hover:text-blue-400 transition-colors">Servicios</a></li>
                    <li><a href="#contacto" class="hover:text-blue-400 transition-colors">Contacto</a></li>
                    <li><a href="#" class="hover:text-blue-400 transition-colors">Política de Privacidad</a></li>
                </ul>
            </div>

            <div>
                <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Contacto</h3>
                <ul class="space-y-4 text-sm">
                    <li class="flex items-center gap-3">
                        <svg class="h-5 w-5 text-blue-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                        <a href="mailto:consultas@estudiogalimberti.com" class="hover:text-white transition-colors">consultas@estudiogalimberti.com</a>
                    </li>
                    <li class="flex items-center gap-3">
                        <svg class="h-5 w-5 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.592 2.654-.696c1.029.575 1.997.892 3.129.89l.004-.001c3.181 0 5.768-2.587 5.768-5.766.001-3.18-2.585-5.767-5.764-5.767H12.03zm-7.662 3.743c-.225-.262-.482-.544-.755-.845l-.463-.513c-.347-.384-.693-.769-1.04-1.154-.347-.384-.693-.769-1.04-1.154-.347-.384-.693-.769-1.04-1.154L.014 2.876c-.053-.058-.094-.127-.123-.202-.029-.074-.044-.153-.044-.232 0-.317.257-.574.574-.574.079 0 .158.015.232.044.075.029.144.07.202.123l1.966 1.772c.385.347.77.693 1.154 1.04.385.347.77.693 1.154 1.04.263.237.526.474.789.711.263.237.526.474.789.711l1.772 1.966c.112.124.112.316-.001.44z"/></svg>
                        <a href="[https://wa.me/5491100000000](https://wa.me/5491100000000)" class="hover:text-white transition-colors font-semibold">+54 9 11 ...</a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="border-t border-slate-800 pt-8 mt-10 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-gray-500">
            <p class="text-center md:text-left">
                &copy; 2025 Estudio Galimberti | Todos los derechos reservados.
            </p>
            <p>Diseño <a href="#" class="hover:text-blue-400 transition-colors font-medium">VisionPath</a></p>
        </div>
    </div>
</footer>

</Layout>